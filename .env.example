# Environment Variables for AutoPatch
# Copy this file to .env and fill in your values

# ─── AI Provider Configuration ────────────────────────────────────────────────
# Provider identifier (e.g., "huggingface", "openai-compatible")
AI_PROVIDER=huggingface

# Base URL for the AI inference API (OpenAI-compatible endpoint)
# Examples:
#   HuggingFace (via Together): https://router.huggingface.co/together/v1
#   HuggingFace (via Novita):   https://router.huggingface.co/novita/v1
#   Together AI direct:          https://api.together.xyz/v1
#   Groq:                        https://api.groq.com/openai/v1
AI_BASE_URL=https://router.huggingface.co/together/v1

# API keys for the AI provider (separated by colons for N keys, e.g. key1:key2:key3)
# Multiple keys enable intelligent load distribution to avoid rate limits (e.g. Groq 8k TPM)
AI_API_KEYS=your_first_key_here:your_second_key_here:your_third_key_here

# Model identifier
# Examples:
#   Qwen/Qwen2.5-Coder-32B-Instruct
#   meta-llama/Llama-3.3-70B-Instruct
#   deepseek-ai/DeepSeek-V3-0324
AI_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# ─── GitHub Configuration ─────────────────────────────────────────────────────
# Optional: GitHub personal access token for higher rate limits
# Without this, the app uses unauthenticated GitHub API (60 req/hour)
# With a token, you get 5000 req/hour
GITHUB_TOKEN=

# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=3001

# Maximum revision attempts (default: 2)
MAX_REVISION_ATTEMPTS=2

